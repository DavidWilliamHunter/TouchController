  m_Script: {fileID: 11500000, guid: 22b8bd1b604448c7b547b1c1036775ff, type: 3}
  m_Name: TouchSettings_Windows
  m_EditorClassIdentifier:
  data:
    density:
      referenceDpi: 96
      fallbackDpi: 192
    motion:
      touchSlopDp: 8
    tap:
      doubleTapTimeoutMs: 500
      doubleTapMinTimeMs: 40
      doubleTapSlopDp: 100
      multiFingerTapWindowMs: 150
    longPress:
      longPressTimeoutMs: 500
    fling:
      minFlingVelocityDps: 50
      maxFlingVelocityDps: 8000
      velocityWindowMs: 100
      swipeAngleToleranceDeg: 30
    pinch:
      minScalingSpanDp: 170
    rotate:
      minRotationDeg: 5
    edge:
      edgeSlopDp: 12
    policy:
      useOsValues: 1
  lineup:
  - gesture: {fileID: 11400000, guid: 5c852bc2a19444aca5700d1b2b74cb6e, type: 2}
